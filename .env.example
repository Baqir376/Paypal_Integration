# ---------------------------------------------------------------------------
# Salix configuration
#
# Copy to .env at the repository root. Every value has a working default, so
# an empty file still runs the whole system on deterministic offline providers.
# ---------------------------------------------------------------------------

# --- Alibaba Cloud Model Studio -------------------------------------------
# Without a key Salix runs in offline mode. With one, every analysis path
# routes to Qwen. The unprefixed name is accepted too, because that is what
# every Alibaba Cloud snippet uses.
DASHSCOPE_API_KEY=
# Optional. When set, requests go to your workspace-scoped endpoint rather
# than the shared international one.
DASHSCOPE_WORKSPACE_ID=
SALIX_DASHSCOPE_REGION=ap-southeast-1

# live | mock | auto   (auto = live if a key is present)
SALIX_PROVIDER_MODE=auto

# --- Bring your own text model (optional) ----------------------------------
# The reasoning layer speaks plain OpenAI protocol, so it can point at any
# compatible endpoint. Transcription, speech and embeddings are DashScope
# services with no standard protocol and are unaffected -- they stay live if
# DASHSCOPE_API_KEY is set and fall back to the offline twins if not.
#
# Leave these blank to use Alibaba Cloud Model Studio, which is the default and
# the only provider that covers all four capabilities.
#
#   Alibaba Model Studio  new accounts get a free quota per model on the
#                         Singapore endpoint the config already points at.
#                         Nothing below is needed -- just DASHSCOPE_API_KEY.
#
#   Google Gemini         https://aistudio.google.com/apikey
#                         Free, and no payment card -- which matters, because
#                         Alibaba requires one for identity verification even
#                         to use its free quota. Gemini also hosts an embedding
#                         model, so this is the only free-without-a-card setup
#                         that gets you genuinely semantic search rather than
#                         the hash-based twin.
#     SALIX_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     SALIX_LLM_API_KEY=...
#                         Use flash-lite, not flash: measured on a real free
#                         account, gemini-3.5-flash allows 20 requests PER DAY
#                         (the API says so itself: quotaValue "20"), which does
#                         not survive a single seed run. flash-lite has its own,
#                         far larger allowance.
#     SALIX_LLM_MODEL_DEEP=gemini-3.1-flash-lite
#     SALIX_LLM_MODEL_FAST=gemini-3.1-flash-lite
#     SALIX_LLM_MODEL_EMBEDDING=gemini-embedding-001
#     SALIX_EMBEDDING_DIM=1536
#
#   Groq                  https://console.groq.com/keys
#     SALIX_LLM_BASE_URL=https://api.groq.com/openai/v1
#
#   Cerebras              https://cloud.cerebras.ai
#     SALIX_LLM_BASE_URL=https://api.cerebras.ai/v1
#
#   OpenRouter            https://openrouter.ai/keys
#     SALIX_LLM_BASE_URL=https://openrouter.ai/api/v1
#
SALIX_LLM_BASE_URL=
SALIX_LLM_API_KEY=
SALIX_LLM_MODEL_DEEP=
SALIX_LLM_MODEL_FAST=

# An embedding model on that same endpoint, if it has one. Retrieval is what
# makes a coaching plan cite the colleague who actually handled the objection;
# without a real embedder the offline twin returns stable, correctly shaped,
# entirely unrelated passages. Groq and Cerebras host no embedding model, so
# leave this blank for them.
#
# Whatever you pick, SALIX_EMBEDDING_DIM below must match what it returns --
# the index has a fixed width and Salix refuses a mismatch rather than
# corrupting the vectors already stored.
SALIX_LLM_MODEL_EMBEDDING=

# --- Transcription with speaker separation ---------------------------------
# The one capability nothing else here can supply, and the reason an upload is
# otherwise stored but never listened to.
#
#   Deepgram   https://console.deepgram.com
#              $200 of credit, NO PAYMENT CARD, and the credit does not expire.
#              Nova-3 covers Urdu, and diarization is included on pre-recorded
#              audio. It also takes the audio in the request body, so no public
#              URL, no OSS bucket and no signed links are needed -- a laptop
#              can transcribe a real call.
SALIX_DEEPGRAM_API_KEY=
SALIX_DEEPGRAM_MODEL=nova-3
# `multi` handles a call that moves between Urdu and English inside one
# sentence, which is the normal register on a Pakistani floor. Set `ur` or `en`
# if a recording is genuinely one language throughout.
SALIX_DEEPGRAM_LANGUAGE=multi

# --- Models ----------------------------------------------------------------
# Only the file-transcription model below supports speaker diarization.
SALIX_MODEL_DEEP=qwen3.8-max
SALIX_MODEL_FAST=qwen-plus
SALIX_MODEL_ASR_FILE=qwen-audio-3.0-asr-flash-filetrans
SALIX_MODEL_ASR_REALTIME=fun-asr-realtime
SALIX_MODEL_EMBEDDING=text-embedding-v4
SALIX_MODEL_TTS=qwen3-tts-instruct-flash
SALIX_EMBEDDING_DIM=1024

# --- Infrastructure --------------------------------------------------------
# SQLite by default so a fresh clone runs with no setup. Point at Postgres for
# the cloud deployment:
#   postgresql+asyncpg://user:pass@host:5432/salix
SALIX_DATABASE_URL=
SALIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Serving this to real people -------------------------------------------
# A shared key on /api. Leave it blank on a laptop; set it before the port is
# reachable by anything else, because without it every recorded call in the
# database is readable by anyone who can open the port. The process says so in
# its startup log rather than leaving it to be discovered.
#
# Generate one:   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Set the SAME value for the API and for Next. The browser never sees it: the
# page calls /api on its own origin, and app/api/[...path]/route.ts attaches
# the key server-side on the way through.
SALIX_API_KEY=

# Courtesy limits on the endpoints that cost tokens, money or minutes. On by
# default; turn it off only behind a proxy that already does this.
SALIX_RATE_LIMIT_ENABLED=true

# Largest recording accepted, in megabytes. An upload declaring more than this
# is refused before it is read.
SALIX_MAX_UPLOAD_MB=200

# --- Frontend --------------------------------------------------------------
# Where Next reaches the API, for the /api proxy and the /audio rewrite.
# docker compose sets this to http://api:8000 itself.
SALIX_API_URL=http://127.0.0.1:8000

# --- Deploying with docker compose -----------------------------------------
# Only needed for `docker compose up`. See docs/DEPLOY.md.
#
# The hostname people will type. It must already resolve to this machine --
# Caddy asks Let's Encrypt for a certificate on the first request, and TLS is
# required rather than nice: browsers refuse microphone access on plain HTTP,
# so an http:// deployment loads fine and the Dojo silently cannot listen.
# Use `localhost` to try the whole stack on your own machine first.
SALIX_DOMAIN=

# Model Studio fetches uploaded audio itself, so with a live key it needs a URL
# it can reach. Either set this to https://<your domain> and let the API serve
# the files, or configure OSS below and leave it blank.
SALIX_PUBLIC_BASE_URL=

# --- Object storage (optional; the deployed path for real audio) ------------
SALIX_OSS_BUCKET=
SALIX_OSS_ENDPOINT=oss-ap-southeast-1.aliyuncs.com
SALIX_OSS_ACCESS_KEY_ID=
SALIX_OSS_ACCESS_KEY_SECRET=
SALIX_OSS_PREFIX=salix/audio
